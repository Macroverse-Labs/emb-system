# FastAPI app
APP_NAME="emb-system backend"
DEBUG=true

# Database (PostgreSQL via asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/emb_system

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=super-secret-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Mailtrap Email Testing SMTP credentials
# Get yours from https://mailtrap.io/email-testing
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=your-mailtrap-username
SMTP_PASSWORD=your-mailtrap-password
SMTP_FROM_EMAIL=noreply@emb-system.local
SMTP_FROM_NAME="emb-system"
SMTP_STARTTLS=true
