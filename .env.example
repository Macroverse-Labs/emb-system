# App
APP_NAME="emb-system backend"
DEBUG=true

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=emb_system

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:3000

# JWT
SECRET_KEY=super-secret-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Mailtrap Email Testing SMTP credentials
# Get yours from https://mailtrap.io/email-testing
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=your-mailtrap-username
SMTP_PASSWORD=your-mailtrap-password
SMTP_FROM_EMAIL=noreply@emb-system.local
SMTP_FROM_NAME="emb-system"
SMTP_STARTTLS=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# GC console seed. The reference dataset loads on API startup so a fresh deployment
# has something to show. CHANGE THE PASSWORD for any deployment other people can
# reach — these defaults create a working administrator account.
GC_SEED_ON_STARTUP=true
GC_ADMIN_EMAIL=gc@mail.com
GC_ADMIN_PASSWORD=admin12345
